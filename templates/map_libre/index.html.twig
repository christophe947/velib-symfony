{% extends 'base.html.twig' %}

{% block title %}MapLibre Prototype{% endblock %}

{% block body_class %}maplibre-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('maplibre-assets/maplibre-gl.css') }}">
    <link rel="stylesheet" href="{{ asset('maplibre/maplibre.css') }}">
{% endblock %}

{% block body %}

    <div id="maplibre-map"></div>

    <div id="station-content">
        <h2>Station Vélib</h2>
        <p>Le panneau est prêt.</p>
    </div>

    <script>
        window.stations = {{ stations|json_encode|raw }};
    </script>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}