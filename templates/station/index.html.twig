{% extends 'base.html.twig' %}

{% block body %}

<div class="container mt-4">

<h1>🚲 Stations Vélib</h1>


<div class="row">

{% for station in stations %}

<div class="col-md-4 mb-3">

<div class="card shadow">

<div class="card-body">

<h5 class="card-title">
{{ station.name }}
</h5>

{% if station.bikes > 10 %}

    <span class="badge text-bg-success">
        Beaucoup de vélos
    </span>

{% elseif station.bikes > 3 %}

    <span class="badge text-bg-warning">
        Disponible
    </span>

{% else %}

    <span class="badge text-bg-danger">
        Presque vide 
    </span>

{% endif %}

<p>
📍 {{ station.address }}
</p>

<hr>

<p>
🚲 Vélos disponibles :
<strong>{{ station.bikes }}</strong>
</p>

<p>
🅿️ Bornes libres :
<strong>{{ station.docks }}</strong>
</p>


</div>

</div>

</div>

{% endfor %}

</div>

</div>

{% endblock %}