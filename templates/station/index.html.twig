{% extends 'base.html.twig' %}

{% block body %}

<div class="container mt-4">

    <h1>🚲 Stations Vélib</h1>

    <div class="mb-4">

        <input
            type="text"
            id="station-search"
            class="form-control"
            placeholder="🔎 Rechercher une station..."
        >

    </div>

    <div class="row">

        {% for station in stations %}

            <div class="col-md-4 mb-3 station-card" data-station-name="{{ station.name|lower }}">

                <div class="card shadow">

                    <div class="card-body">

                        <h5 class="card-title">
                            {{ station.name }}
                        </h5>

                        <span class="badge text-bg-success">
                            🚲 {{ station.rentalStatus }}
                        </span>

                        <span class="badge text-bg-primary">
                            🅿️ {{ station.returnStatus }}
                        </span>

                        <p class="mt-3">
                            📍 {{ station.address }}
                        </p>

                        <hr>

                        <p>
                            🚲 Vélos disponibles :
                            <strong>{{ station.bikes }}</strong>
                        </p>

                        <p>
                            🅿️ Bornes libres :
                            <strong>{{ station.docks }}</strong>
                        </p>

                    </div>

                </div>

            </div>

        {% endfor %}

    </div>

</div>

{% endblock %}