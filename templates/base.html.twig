<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Velib Tracker - Disponibilité des stations Vélib en temps réel{% endblock %}</title>
    <meta name="description" content=" {% block meta_description %} Consultez la disponibilité des stations Vélib en temps réel grâce à une carte interactive{% endblock %}">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Christophe Gobet">
    <meta name="theme-color" content="#198754">
    <!-- Open Graph -->
    <meta property="og:title" content="Velib Tracker">
    <meta property="og:description" content="Consultez la disponibilité des stations Vélib en temps réel grâce à une carte interactive.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://velib-tracker.fr">
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>

<body>

<nav class="navbar navbar-expand-lg bg-dark navbar-dark shadow">
    <div class="container">

        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            🚲 Velib Tracker
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav">

            <span class="navbar-toggler-icon"></span>

        </button>


        <div class="collapse navbar-collapse" id="mainNav">

            <ul class="navbar-nav ms-auto gap-2">

                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}" href="{{ path('app_home') }}">
                    Accueil
                </a>

                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_stations' %}active{% endif %}" href="{{ path('app_stations') }}">
                    Stations
                </a>

                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_map' %}active{% endif %}" href="{{ path('app_map') }}">
                    Carte
                </a>

            </ul>

        </div>

    </div>
</nav>



<main>
    {% block body %}{% endblock %}
</main>

<footer class="border-top mt-5 py-4">
    <div class="container text-center">

        <div class="mb-2">
            🚲 <strong>Velib Tracker</strong>
        </div>

        <div class="small text-muted mb-3">
            Visualisation des disponibilités Vélib' en temps réel
        </div>

        <div class="small mb-3">
            Contact :
            <a href="mailto:support@velib-tracker.fr">
                support@velib-tracker.fr
            </a>
        </div>

        <div class="small text-secondary mt-3">

            <div class="mb-2">
                Réalisé avec
            </div>

            <div class="d-flex justify-content-center align-items-center gap-4">

                <img src="{{ asset('images/symfony_logo.svg') }}"
                     alt="Symfony"
                     height="28">

                <img src="{{ asset('images/bootstrap_logo.svg') }}"
                     alt="Bootstrap"
                     height="28">

                <img src="{{ asset('images/leaflet_logo.svg') }}"
                     alt="Leaflet"
                     height="28">

            </div>

        </div>

        <div class="small text-secondary mt-3">
            © {{ "now"|date("Y") }} Velib Tracker
        </div>

    </div>
</footer>

{% block javascripts %}
{% endblock %}

</body>
</html>
