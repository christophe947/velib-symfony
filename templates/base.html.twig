<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %}</title>

    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>

<body>

<nav class="navbar navbar-expand-lg bg-dark navbar-dark shadow">
    <div class="container">

        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            🚲 Velib Tracker
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav">

            <span class="navbar-toggler-icon"></span>

        </button>


        <div class="collapse navbar-collapse" id="mainNav">

            <ul class="navbar-nav ms-auto gap-2">

                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}" href="{{ path('app_home') }}">
                    Accueil
                </a>

                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_stations' %}active{% endif %}" href="{{ path('app_stations') }}">
                    Stations
                </a>

                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_map' %}active{% endif %}" href="{{ path('app_map') }}">
                    Carte
                </a>

            </ul>

        </div>

    </div>
</nav>



<main>
    {% block body %}{% endblock %}
</main>


{% block javascripts %}
{% endblock %}

</body>
</html>
