{% extends 'base.html.twig' %}

{% block title %}
    Carte des stations Vélib en temps réel | Velib Tracker
{% endblock %}

{% block meta_description %}
    Visualisez les vélos et les bornes disponibles sur la carte des stations Vélib.
{% endblock %}

{% block body %}

<div class="container-fluid mt-3">

    <div class="mb-3 ">
        <h1 class="h3 mb-1"><!-- 🗺️ --> Carte des stations</h1>
    
        <!--<p class="text-muted mb-0">
            Trouvez rapidement un vélo disponible près de vous
        </p>-->
    </div>

    <div class="d-flex justify-content-center mb-3">

        <div class="btn-group" role="group">
            <button 
                id="mode-bikes"
                class="btn btn-primary active">
                🚲 Prendre
            </button>

            <button 
                id="mode-docks"
                class="btn btn-outline-primary">
                🅿️ Rendre
            </button>
        </div>
    </div>

    <!--<div id="map" class="map-container"></div>-->
    <div class="row map-layout g-3">

        <div class="col-lg-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="search-container">

                        <form id="station-search-form" class="mb-3">
                            <input 
                                id="station-search"
                                type="search"
                                class="form-control"
                                placeholder="Rechercher une station..."
                                autocomplete="off">
                        </form>
                        
                        


                        <div id="station-results"></div>

                    </div>


                    <div id="station-panel">

                        <h2>Station</h2>

                        <p class="text-muted">
                            Cliquez sur une station sur la carte
                        </p>

                    </div>

                </div>

            </div>

        </div>
        
    

        <div class="col-lg-8">

            <div id="map" class="map-container">
            </div>

        </div>

    </div>

    <script>
        window.stations = {{ stations|json_encode|raw }};
        const selectedStation = {{ selectedStation|json_encode|raw }};
    </script>

</div>

{% endblock %}