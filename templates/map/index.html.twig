{% extends 'base.html.twig' %}

{% block title %}
    Carte des stations Vélib en temps réel | Velib Tracker
{% endblock %}

{% block meta_description %}
    Visualisez les vélos et les bornes disponibles sur la carte des stations Vélib.
{% endblock %}

{% block body %}


<div class="container-fluid mt-3">

    
    <div class="d-flex justify-content-center mb-3 mt-3 mode-buttons">

        <div class="btn-group" role="group">
            <button 
                id="mode-bikes"
                class="btn btn-primary active"
                aria-label="bouton pour afficher les stations avec vélos disponibles">
                🚲 Prendre
            </button>

            <button 
                id="mode-docks"
                class="btn btn-outline-primary"
                aria-label="bouton pour afficher les stations avec places disponibles">
                🅿️ Rendre
            </button>
        </div>
    </div>

    <!--<div id="map" class="map-container"></div>-->
    <div class="row map-layout g-3">

        <div class="col-lg-4 mb-3 map-search-panel">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="search-container">

                        <form id="station-search-form" class="mb-3 mobile-search">
                            <input 
                                id="station-search"
                                type="search"
                                class="form-control"
                                placeholder="Rechercher une station..."
                                autocomplete="off">
                        </form>
                        
                        


                        <div id="station-results"></div>

                    </div>


                    <div
                        id="station-panel"
                        class="station-bottom-sheet"
                        tabindex="-1"
                        aria-labelledby="station-panel-title">

                        <div class=" station-panel-header">

                            <div class="station-panel-handle" aria-hidden="true"></div>


<div class="station-panel-title-row">
                            <h2
                                id="station-panel-title"
                                class="">
                                Station
                            </h2>

                            <button
                                type="button"
                                class="btn-close"
                                aria-label="Fermer">
                            </button>
                            </div>

                        </div>

                        <div class="station-panel-body">

                            <p class="text-muted">
                                Cliquez sur une station sur la carte
                            </p>

                        </div>

                    </div>



                </div>

            </div>

        </div>
        
    

        <div class="col-lg-8">

            <div id="map" class="map-container">
            </div>

        </div>

    </div>

    <script>
        window.stations = {{ stations|json_encode|raw }};
        const selectedStation = {{ selectedStation|json_encode|raw }};
    </script>

</div>

{% endblock %}